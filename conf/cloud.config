/*
 * Full-scale resource requests for cloud/HPC executors (M8).
 *
 * Included by the aws / google / azure / slurm profiles in nextflow.config to
 * override the deliberately tiny dev-host caps in conf/base.config. These are
 * sized for real human WGS/WES rather than the 8 GB smoke-test host. Tune to
 * your queue/quota; every process is still labelled process_single|medium|high.
 */

params {
    max_cpus   = 16
    max_memory = '120.GB'
    max_time   = '48.h'
}

process {
    // Retry once with more memory on out-of-memory/preemption before failing;
    // spot/preemptible instances make transient failures normal at scale.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { 36.GB * task.attempt }
        time   = '12.h'
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = '24.h'
    }
}
